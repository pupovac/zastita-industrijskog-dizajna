# Keep the build context small and deterministic. node_modules is always
# reinstalled inside the image from package-lock.json; local DB / uploads and
# build output must never leak into the image.
**/node_modules
**/dist
**/.git
**/.github
**/*.log

# Local Prisma SQLite database and any dev artifacts (the real DB lives on a PVC).
apps/api/prisma/dev.db
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
apps/api/.env
apps/api/storage

# docs/ is NOT excluded: the api image ships it (COPY docs /app/docs) because the
# research import and the local copies of the sources are read from it at runtime.
# Only generator scripts and derived renderings of the matrix are left out.
docs/faza-2/render_matrix.py
docs/faza-2/matrica-zahteva-zis.csv

# Editor / OS noise
.DS_Store
**/.vscode
**/.idea
